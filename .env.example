# Copy this file to .env and fill in the values.

# Shared secret. The Express server must send it as the X-API-Key header.
SERVICE_API_KEY=change-me

# Replicate token for virtual try-on (Phase 5). Leave empty while TRYON_MOCK=true.
REPLICATE_API_TOKEN=

# Which try-on provider to use: replicate_idm | catvton | mock
TRYON_PROVIDER=replicate_idm

# true = return a placeholder image and never call Replicate (no cost during development)
TRYON_MOCK=false

# debug | info | warning | error
LOG_LEVEL=info
# text (readable, for development) | json (one JSON object per line, for production)
LOG_FORMAT=text

PORT=8000

# MediaPipe pose model: lite | full | heavy (download with scripts/download_models.py)
POSE_MODEL=heavy

# Pin a Replicate IDM-VTON version id (empty = latest version of cuuupid/idm-vton)
REPLICATE_IDM_VERSION=

# Safety cap on /try-on calls per minute across all users (0 = no limit)
TRYON_RATE_LIMIT_PER_MINUTE=30
